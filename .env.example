MONGODB_URI=mongodb://localhost:27017/my_store_ai
FRONTEND_URL=http://localhost:5173

# Segredo compartilhado com o ordembee-cardapio-web-backend-api (assinatura HMAC da rota /internal/*).
# Gere com: openssl rand -hex 32
INTERNAL_API_SECRET=

# Firebase Storage
STORAGE_BUCKET=your-project.firebasestorage.app

# Firebase Admin SDK (Service Account)
ADMIN_PROJECT_ID=your-project-id
ADMIN_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Chave que cifra credenciais de terceiros (client secret da Uber Direct) no Mongo.
# 64 caracteres hex. Gere com: openssl rand -hex 32 — trocar a chave invalida o que ja foi gravado.
CREDENTIALS_ENCRYPTION_KEY=

# Uber Direct: URL publica do webhook (ordembee-cardapio-web-backend-api) mostrada na tela de configuracao.
# Ex.: https://ordembee-cardapio-digital.web.app/v1/webhooks/uber-direct
UBER_WEBHOOK_PUBLIC_URL=
# Opcionais (testes locais contra um mock): UBER_AUTH_URL, UBER_API_BASE_URL

# InfinitePay: URL publica do webhook (ordembee-cardapio-web-backend-api) enviada em cada link de pagamento.
# Ex.: https://ordembee-cardapio-digital.web.app/v1/webhooks/infinitepay — vazio = sem webhook (a confirmacao vem pela consulta ao voltar do checkout).
INFINITEPAY_WEBHOOK_PUBLIC_URL=
# Opcional (testes locais contra um mock): INFINITEPAY_API_BASE_URL
